# =============================================================================
# FineTune Studio - frontend configuration
# =============================================================================
# Copy this file to `frontend/.env.local` only if you need to change defaults.
# All API traffic is proxied through Next.js rewrites so the browser never
# sees a cross-origin request.
# =============================================================================

# Where the FastAPI backend is reachable. Used by next.config.mjs to proxy
# /api/* and /health.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# =============================================================================
# FineTune Studio - backend configuration
# =============================================================================
# Copy this file to `backend/.env` and fill in the LLM section. The agent
# refuses to chat until both LLM_PROVIDER and LLM_MODEL are set, plus an
# API key for any cloud provider.
#
# UI settings always override values from this file. To go back to the .env
# values, click "clear UI override" on the Settings page.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM provider (the agent's brain)
# -----------------------------------------------------------------------------
# Pick ONE provider. Every name below is supported out of the box. Cloud
# providers need a key; local providers (ollama, lmstudio, vllm) do not.
#
#   anthropic    Anthropic Claude                console.anthropic.com
#   openai       OpenAI                          platform.openai.com
#   gemini       Google Gemini                   aistudio.google.com
#   groq         Groq                            console.groq.com
#   grok         xAI Grok                        x.ai
#   deepseek     DeepSeek                        platform.deepseek.com
#   mistral      Mistral AI                      console.mistral.ai
#   together     Together AI                     api.together.xyz
#   fireworks    Fireworks AI                    fireworks.ai
#   openrouter   OpenRouter (300+ models)        openrouter.ai
#   perplexity   Perplexity                      perplexity.ai/settings/api
#   cohere       Cohere                          dashboard.cohere.com
#   huggingface  Hugging Face Inference Router   huggingface.co/settings/tokens
#   ollama       Ollama (local)                  ollama.com  -  no key
#   lmstudio     LM Studio (local)               lmstudio.ai  -  no key
#   vllm         vLLM (local)                    docs.vllm.ai  -  no key
#   custom       Any OpenAI-compatible server    set LLM_BASE_URL  -  no key
LLM_PROVIDER=anthropic

# API key for the chosen provider. Leave blank for local providers
# (ollama / lmstudio / vllm / custom).
LLM_API_KEY=

# Model identifier the provider serves. Examples per provider:
#   anthropic    claude-sonnet-4-5, claude-opus-4-5, claude-haiku-4-5
#   openai       gpt-4o, gpt-4o-mini, gpt-4.1
#   gemini       gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
#   groq         llama-3.3-70b-versatile, mixtral-8x7b-32768
#   grok         grok-2-latest, grok-2-mini
#   deepseek     deepseek-chat, deepseek-reasoner
#   mistral      mistral-large-latest, mistral-small-latest
#   together     meta-llama/Llama-3.3-70B-Instruct-Turbo
#   fireworks    accounts/fireworks/models/llama-v3p1-70b-instruct
#   openrouter   anthropic/claude-3.5-sonnet, openai/gpt-4o
#   perplexity   sonar, sonar-pro, sonar-reasoning
#   cohere       command-r-plus, command-r
#   huggingface  meta-llama/Llama-3.1-8B-Instruct
#   ollama       llama3.1:8b, qwen2.5:7b, mistral:7b
LLM_MODEL=claude-sonnet-4-5

# Optional. Override the API base URL.
# - If you set LLM_PROVIDER to one of the named providers, leave this blank
#   to use that provider's default URL.
# - Set this when LLM_PROVIDER=custom, or when you proxy a known provider
#   through your own gateway.
# Defaults the provider list bakes in:
#   anthropic    https://api.anthropic.com
#   openai       https://api.openai.com/v1
#   gemini       https://generativelanguage.googleapis.com/v1beta/openai
#   groq         https://api.groq.com/openai/v1
#   grok         https://api.x.ai/v1
#   deepseek     https://api.deepseek.com/v1
#   mistral      https://api.mistral.ai/v1
#   together     https://api.together.xyz/v1
#   fireworks    https://api.fireworks.ai/inference/v1
#   openrouter   https://openrouter.ai/api/v1
#   perplexity   https://api.perplexity.ai
#   cohere       https://api.cohere.ai/compatibility/v1
#   huggingface  https://router.huggingface.co/v1
#   ollama       http://localhost:11434/v1
#   lmstudio     http://localhost:1234/v1
#   vllm         http://localhost:8000/v1
LLM_BASE_URL=


# -----------------------------------------------------------------------------
# 2. Hugging Face token (optional)
# -----------------------------------------------------------------------------
# Required only if you want to:
#   - pull base models from the Hub for fine-tuning
#   - push trained adapters back to the Hub
# Create one at https://huggingface.co/settings/tokens (read for pulls,
# read+write for pushes).
HF_TOKEN=


# -----------------------------------------------------------------------------
# 3. Server settings (defaults are fine for local use)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Where on-disk JSON state, uploaded datasets, and trained models live.
# Paths are resolved relative to the directory you run uvicorn from.
DATA_DIR=./data
UPLOAD_DIR=./uploads
MODELS_DIR=./models


# -----------------------------------------------------------------------------
# 4. Security
# -----------------------------------------------------------------------------
# Symmetric key for encrypting stored API keys at rest. Auto-generated on
# first run and persisted under data/.encryption_key. Set this only if you
# want a fixed key shared across machines.
ENCRYPTION_KEY=

# Frontend origins allowed to call the API. The Next.js dev server runs on
# port 3000 by default.
CORS_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000

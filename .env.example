# ============================================================
# FineTune Studio v6 — configuration
# Copy to .env and fill in. The app reads this at boot; the
# ConfigBanner in the UI tells you what's missing.
# ============================================================

# --- LLM provider (fully custom: any OpenAI-compatible or Anthropic-style endpoint) ---
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:      http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Wire protocol: openai (default, covers everything above) | anthropic
LLM_API_STYLE=openai
# Optional cheaper model for worker subagents (defaults to LLM_MODEL)
LLM_MODEL_WORKER=

# --- Pricing (USD per 1 MILLION tokens; the source of truth for budgeting) ---
# Set both to 0 for free-tier keys — the run is then metered at $0.
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=
# Optional (Anthropic-style prompt caching). Defaults: read = 0.1x input, write = 1.25x input.
LLM_PRICE_CACHE_READ=
LLM_PRICE_CACHE_WRITE=

# --- Capabilities ---
# off | minimal | low | medium | high | <integer thinking-token budget>
LLM_THINKING=off
# true = inject the provider's native web-search tool when supported
LLM_WEB_SEARCH=false
# Context window + max output tokens of your model (drives compaction + cost ceilings)
LLM_CONTEXT_WINDOW=128000
LLM_MAX_OUTPUT_TOKENS=8192

# --- Budget (replaces rate limiting) ---
# The ENTIRE run (analyze -> preprocess -> train -> eval -> HF upload) must fit
# in this budget. The agent pauses and asks for a top-up when it projects overrun.
LLM_BUDGET_USD=2
# Soft-warning threshold (fraction of budget)
LLM_BUDGET_SOFT=0.85
# Fraction reserved so evaluation + upload are never cut off mid-run
LLM_BUDGET_FINALIZE_RESERVE=0.05

# --- Autonomy ---
# plan (default): agent proposes ONE master plan for approval, then scripts auto-run.
# every-command:  Claude Code-style — every terminal command needs approval.
# auto:           no approvals at all (HF upload still asks).
APPROVAL_MODE=plan

# --- Limits ---
MAX_TURNS=80

# --- Hugging Face (only needed for model upload) ---
HF_TOKEN=

# --- Paths (optional overrides) ---
# DATA_DIR=./data
# WORKSPACES_DIR=./workspaces
